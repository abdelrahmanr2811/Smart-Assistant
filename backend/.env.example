# App Configuration
APP_NAME="Smart Assistant - Construction PM AI"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# LLM Providers Configuration
# Supported providers: "openai", "gemini", "local"
LLM_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"

# Whisper Audio Transcription
# Options: "openai_cloud", "local_whisper", "gemini"
WHISPER_MODE="openai_cloud"
WHISPER_LOCAL_MODEL="base"

# Database & ChromaDB Paths
DATABASE_URL="sqlite:///./data/smart_assistant.db"
CHROMA_PERSIST_DIR="./data/chromadb"
UPLOAD_DIR="./data/uploads"

# SMTP Email Configuration (Human-In-The-Loop action execution)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@company.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="notifications@company.com"
SMTP_USE_TLS=True

# Google Calendar OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
